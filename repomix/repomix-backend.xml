def map_faq_item_to_knowledge_unit(
    item: dict[str, Any], *, default_domain: str = "hr"
) -> KnowledgeUnit:
    return KnowledgeUnit(
        unit_id=item.get("id", ""),
        source_kind="faq",
        question=item.get("question", ""),
        answer=item.get("answer", ""),
        body_text=item.get("answer", ""),
        keywords=tuple(item.get("keywords", [])),
