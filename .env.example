# OrionStack 环境配置参考
#
# 复制本文件为 .env 并按需修改。
# 当前后端通过环境变量读取配置，不依赖 .env 文件自动加载。
# 如需 .env 自动加载，请在启动脚本或工具链中自行引入 python-dotenv。

# ── 应用 ──

ORIONSTACK_APP_NAME=OrionStack Demo
ORIONSTACK_APP_MODE=demo
ORIONSTACK_HOST=127.0.0.1
ORIONSTACK_PORT=8000

# ── CORS ──

# 允许的前端来源，多个用逗号分隔。
# 不设置时默认为开发环境来源：
#   http://localhost:5173,http://127.0.0.1:5173
# 生产环境应改为实际部署域名，例如：
#   ORIONSTACK_CORS_ORIGINS=https://app.example.com
ORIONSTACK_CORS_ORIGINS=

# ── 检索 ──

ORIONSTACK_ROUTE_CONFIDENCE_THRESHOLD=0.15
ORIONSTACK_RETRIEVAL_MIN_SCORE=1

# ── 记录保留 ──

ORIONSTACK_CHAT_RECORD_MAX_COUNT=200
ORIONSTACK_FEEDBACK_RECORD_MAX_COUNT=200

# ── Phase 2: 搜索后端 ──

# 搜索后端类型：elasticsearch（默认全开档）或 local（硬回退）
ORIONSTACK_SEARCH_BACKEND=elasticsearch

# Elasticsearch 连接地址
ORIONSTACK_ELASTIC_URL=http://localhost:9200

# Elasticsearch 索引名称
ORIONSTACK_ELASTIC_INDEX=knowledge_units_v1

# 是否启用 IK 分词器（需要 ES 安装 IK 插件）
ORIONSTACK_ELASTIC_USE_IK_ANALYZER=false

# ── Phase 2: Query Planner ──

# 是否启用 Query Planner（默认启用）
ORIONSTACK_ENABLE_QUERY_PLANNER=true

# Planner 提供者：local 或 ollama
ORIONSTACK_PLANNER_PROVIDER=local

# Planner 模型（ollama 模式时使用）
ORIONSTACK_PLANNER_MODEL=gemma3:1b

# Ollama 服务地址
ORIONSTACK_OLLAMA_URL=http://localhost:11434

# ── Phase 2: Fast Track ──

# 是否启用 Fast Track（默认启用）
ORIONSTACK_ENABLE_FAST_TRACK=true
