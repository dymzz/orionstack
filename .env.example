# OrionStack 环境配置参考
#
# 使用：复制本文件为 .env 并按需修改，后端启动时会自动加载（见
# backend/app/config/settings.py 顶部的 load_dotenv 调用）。
#
# 优先级：启动进程已有的环境变量 > .env 条目（override=False）。
# 如果发现 .env 修改没有生效，请确认启动进程或系统环境中没有同名变量。

# 本地演示。生产设置 oidc，身份由外部 IdP 提供，网页使用 HttpOnly session。
ORIONSTACK_AUTH_MODE=demo
ORIONSTACK_PUBLIC_ORIGIN=http://127.0.0.1:5173
# ORIONSTACK_OIDC_ISSUER=https://idp.example.internal/realms/orion
# ORIONSTACK_OIDC_CLIENT_ID=orionstack-web
# ORIONSTACK_OIDC_CLIENT_SECRET 由 OpenBao Agent/部署环境注入，不填写秘密值。

# ── 下一版本 Core（单 PostgreSQL + pgvector / 本地 Qwen3 ONNX / 可选 Jev / DeepSeek） ──
# 连接串与密钥由启动进程环境提供，不写入源码或镜像。
# ORIONSTACK_DATABASE_URL=postgresql://user:password@localhost:5432/orionstack
# TYPESAFE_API_KEY=<Jev key>
# DEEPSEEK_API_KEY=<DeepSeek key>
# CF_API_TOKEN=<Workers AI token>
# CF_ACCOUNT_ID=<Cloudflare account ID>
# 默认本地 ONNX；Cloudflare 是显式选择的备选，不自动混用模型空间。
ORIONSTACK_EMBEDDING_PROVIDER=onnx
ORIONSTACK_ONNX_DIR=D:\workspace\models\Qwen--Qwen3-Embedding-0.6B\Qwen3-Embedding-0.6B-ONNX
ORIONSTACK_ONNX_MODEL=Qwen/Qwen3-Embedding-0.6B
ORIONSTACK_ONNX_THREADS=8
ORIONSTACK_ONNX_MAX_TOKENS=8192
# 以下模型/修订仅供 cloudflare_workers_ai provider 使用。
ORIONSTACK_EMBEDDING_MODEL=@cf/baai/bge-m3
ORIONSTACK_EMBEDDING_DIMENSIONS=1024
ORIONSTACK_EMBEDDING_REVISION=provider-managed
ORIONSTACK_JEV_API_BASE=https://api.typesafe.ai/v1
ORIONSTACK_JEV_MODEL=jev-1.13.0
ORIONSTACK_DEEPSEEK_API_BASE=https://api.deepseek.com
ORIONSTACK_DEEPSEEK_MODEL=deepseek-flash
ORIONSTACK_DEFAULT_TENANT_ID=default
ORIONSTACK_QUERY_USE_JEV=false
# Signed account -> tenant/scopes. Empty mapping enables single-tenant internal access.
# Nonempty mapping denies unlisted accounts; roles come from signed server accounts.
ORIONSTACK_CORE_PRINCIPALS={}
ORIONSTACK_CORE_PROVIDER_TIMEOUT_SECONDS=30
ORIONSTACK_DATABASE_CONNECT_TIMEOUT_SECONDS=5
# /api/query 和 /api/documents 已实现；旧网页仍调用 /api/v1/chat/ask。
#
# 切换 planner provider：在下方 Planner 区块注释/取消注释对应的小块即可。

# ── 应用 ──

ORIONSTACK_APP_NAME=OrionStack Demo
ORIONSTACK_APP_MODE=demo
ORIONSTACK_HOST=127.0.0.1
ORIONSTACK_PORT=8000

# ── 日志 ──

# 级别：DEBUG / INFO / WARNING / ERROR / CRITICAL
ORIONSTACK_LOG_LEVEL=INFO

# 是否输出简要 access log（method/path/status/duration，不记录请求体或 token）。
ORIONSTACK_ACCESS_LOG_ENABLED=true

# ── CORS ──

# 允许的前端来源，多个用逗号分隔。
# 不设置时默认为开发环境来源：
#   http://localhost:5173,http://127.0.0.1:5173
# 生产环境应改为实际部署域名，例如：
#   ORIONSTACK_CORS_ORIGINS=https://app.example.com
ORIONSTACK_CORS_ORIGINS=

# ── 检索 ──

ORIONSTACK_ROUTE_CONFIDENCE_THRESHOLD=0.15
ORIONSTACK_RETRIEVAL_MIN_SCORE=1

# ── 记录保留 ──

ORIONSTACK_CHAT_RECORD_MAX_COUNT=200
ORIONSTACK_FEEDBACK_RECORD_MAX_COUNT=200

# ── 管理入口认证 ──

# `/admin/*` 前端页面与对应管理 API 使用最小 Bearer token 认证。
# 默认值仅方便本地 demo；prod 模式下如果仍使用默认密码/secret，后端会拒绝启动。
# token secret 生产值至少 24 个字符。
ORIONSTACK_ADMIN_USERNAME=admin
ORIONSTACK_ADMIN_PASSWORD=admin
ORIONSTACK_ADMIN_TOKEN_SECRET=change-this-in-production
ORIONSTACK_ADMIN_TOKEN_TTL_SECONDS=28800

# ── Phase 2: 搜索后端 ──

# 过渡版本使用本地检索；下版本接入单库 PostgreSQL + pgvector + Jev
ORIONSTACK_SEARCH_BACKEND=local

# Elasticsearch 连接地址
ORIONSTACK_ELASTIC_URL=http://localhost:9200

# Elasticsearch 索引名称
ORIONSTACK_ELASTIC_INDEX=knowledge_units_v1

# 是否启用 IK 分词器（需要 ES 安装 IK 插件）
ORIONSTACK_ELASTIC_USE_IK_ANALYZER=false

# ── Phase 2: Query Planner ──

# 旧 Query Planner 默认关闭，后续由 Jev 检索决策接替
ORIONSTACK_ENABLE_QUERY_PLANNER=false

# ─── Planner Provider：选择一组取消注释 ───────────────────────────────────
#
# 架构：planner provider 通过注册表选择，当前内置 `local` /
# `openai_compatible` / `qwen_api`（兼容别名）/ `llama_cpp`。
# 新配置建议优先使用通用变量 `ORIONSTACK_PLANNER_API_*`；旧的
# `ORIONSTACK_QWEN_API_*` 与 `DASHSCOPE_API_KEY` / `QWEN_API_KEY`
# 仍保留兼容读取，但不再是唯一入口。
#
# 契约证据（文件名按 {backend_tag}__{model} 自动派生）：
# - DashScope qwen-plus：docs/2_8_smoke_live_results__cloud__qwen-plus.json
#   （19/19 活体契约绿）
# - 本地 Qwen3-1.7B：跑一次 test_planner_openai_compatible_live.py 会落盘到
#   docs/2_8_smoke_live_results__local__qwen3-1.7b-q4_k_m.json，可量化关了
#   几条 2_6 §5 契约债

# ─── 选项 A：任意 OpenAI-compatible 云端（默认示例：DashScope qwen-plus） ─
# 启用本块前需要到 https://dashscope.aliyun.com 申请 API Key。
ORIONSTACK_PLANNER_PROVIDER=openai_compatible
ORIONSTACK_PLANNER_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
ORIONSTACK_PLANNER_API_MODEL=qwen-plus
ORIONSTACK_PLANNER_API_KEY=sk-your-key-here
# 兼容旧配置时，也可以改用下面这组变量：
# ORIONSTACK_QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# ORIONSTACK_QWEN_API_MODEL=qwen-plus
# DASHSCOPE_API_KEY=sk-your-key-here

# ─── 选项 B：本地 llama-server + Qwen/Qwen3-1.7B-GGUF（离线 / 省配额） ───
# 先启动 llama-server：
#   llama-server.exe --model D:\models\qwen3-1.7b\Qwen3-1.7B-Q4_K_M.gguf ^
#                    --host 127.0.0.1 --port 8080 --ctx-size 4096 --jinja
# 确认启动：浏览器开 http://127.0.0.1:8080/v1/models 看到模型 id
#
# 然后注释掉选项 A 的 4 行，取消下面 4 行的注释：
# ORIONSTACK_PLANNER_PROVIDER=llama_cpp
# ORIONSTACK_LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
# ORIONSTACK_LOCAL_LLM_MODEL=Qwen3-1.7B-Q4_K_M
# ORIONSTACK_PLANNER_API_KEY=dummy-not-required

# ─── 选项 C：纯规则 LocalRuleProvider（无网 / 无 LLM / 仅 fallback 自测） ─
# 不经任何 LLM，planner 全走确定性规则。域分类始终为 null，置信度恒 0.88，
# lexical_terms 会包含字符碎片 —— 仅用于脱网自测或 fallback 契约验证。
# ORIONSTACK_PLANNER_PROVIDER=local

# ─── Planner 共享设置 ──────────────────────────────────────────────────

# HTTP 调用超时（秒）；本地小模型推理较慢，可适当调大
ORIONSTACK_PLANNER_TIMEOUT_SECONDS=30

# 同进程相同 normalized_query 走缓存，默认启用
ORIONSTACK_PLANNER_CACHE_ENABLED=true

# ── Phase 2: Fast Track ──

# 旧 Fast Track 默认关闭
ORIONSTACK_ENABLE_FAST_TRACK=false

# ── Phase 3: 抽取与动态查询 ──

# 抽取 provider 与 planner 解耦，当前内置 `openai_compatible` /
# `qwen_api`（兼容别名）/ `llama_cpp`。默认示例仍是 DashScope qwen-plus，
# 但这里只是当前实现约定，不是架构绑定；只要目标端点兼容 OpenAI Chat
# Completions 契约即可。
ORIONSTACK_EXTRACTION_PROVIDER=openai_compatible
ORIONSTACK_EXTRACTION_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
ORIONSTACK_EXTRACTION_API_MODEL=qwen-plus
ORIONSTACK_EXTRACTION_API_KEY=
# 兼容旧配置时，也可以继续使用：
# ORIONSTACK_QWEN_API_KEY=
# DASHSCOPE_API_KEY=

# 动态查询通过 adapter 接外部系统。默认使用 MockAdapter 便于本地脱网启动。
# 如需验证当前 Odoo 示例适配器，将本项改为 odoo 并填写下方连接信息。
ORIONSTACK_DYNAMIC_QUERY_ADAPTER=mock
ORIONSTACK_ODOO_URL=http://localhost:8069
ORIONSTACK_ODOO_DB=odoo
ORIONSTACK_ODOO_UID=2
# 仅在 ORIONSTACK_DYNAMIC_QUERY_ADAPTER=odoo 时需要。
ORIONSTACK_ODOO_PASSWORD=

# DataOps Assets: external S3 API, detection and scanning. Secrets are injected by OpenBao/environment.
ORIONSTACK_S3_ENDPOINT=
ORIONSTACK_S3_BUCKET=
ORIONSTACK_S3_REGION=us-east-1
ORIONSTACK_S3_ACCESS_KEY_ID=
ORIONSTACK_S3_SECRET_ACCESS_KEY=
ORIONSTACK_S3_SESSION_TOKEN=
ORIONSTACK_TIKA_URL=
ORIONSTACK_CLAMAV_HOST=
ORIONSTACK_CLAMAV_PORT=3310
# tus/tusd integration is reserved, not enabled by merely providing this endpoint.
ORIONSTACK_TUS_ENDPOINT=
# Backend host has pgBackRest installed/configured, or uses a deployment-controlled wrapper.
ORIONSTACK_PGBACKREST_BIN=pgbackrest
ORIONSTACK_PGBACKREST_STANZA=
ORIONSTACK_PGBACKREST_REPO=1
ORIONSTACK_PGBACKREST_CONFIG=
# Comma-separated tenant_id:principal_id. Tenant admin alone cannot read cluster backups.
ORIONSTACK_BACKUP_OPERATORS=
# Optional server-owned policy file. Empty uses the versioned default DataOps Cedar policies.
ORIONSTACK_CEDAR_POLICY_FILE=
# Unknown retention values are pending a deployment/customer decision, not infinite retention.
ORIONSTACK_RETENTION_SOURCE_DAYS=
ORIONSTACK_RETENTION_DERIVED_DAYS=
ORIONSTACK_RETENTION_AUDIT_DAYS=
ORIONSTACK_RETENTION_TELEMETRY_DAYS=
ORIONSTACK_RETENTION_OLD_ASSET_VERSION_DAYS=
ORIONSTACK_RETENTION_RAW_RETRIEVAL_DAYS=
# Retired document upload is off. Production always rejects this compatibility option.
ORIONSTACK_ENABLE_LEGACY_DOCUMENT_UPLOAD=false
